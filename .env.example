# ===== NoneBot2 基础配置 =====
DRIVER=~fastapi
HOST=127.0.0.1
PORT=8080
LOG_LEVEL=INFO
COMMAND_START=["/"]
COMMAND_SEP=[" "]
NICKNAME=["莓莓", "BerryStudio"]

# 超级管理员 QQ 号（JSON 数组），优先级最高，不需要在数据库里额外配置
SUPERUSERS=[]

# ===== BerryStudio 业务配置 =====
# SQLite 数据库文件（服务器上的“sql 文件”）
BERRY_DB_PATH=data/berrystudio.db
# 业务时区
BERRY_TIMEZONE=Asia/Shanghai
# 额外管理员 QQ 号，支持 JSON 数组或逗号分隔，例如 ["10001", "10002"]
BERRY_ADMIN_QQ=[]
# 后台 HTTP API 令牌，留空表示关闭 HTTP 管理接口
BERRY_ADMIN_API_TOKEN=
# 中文字体路径，留空则自动探测系统字体
BERRY_FONT_PATH=
# 渲染图片的临时目录
BERRY_IMAGE_DIR=data/images
# 预约时间对齐粒度（分钟）
BERRY_SLOT_MINUTES=30
# 至少提前多少分钟预约
BERRY_MIN_LEAD_MINUTES=30
# 最多可提前多少天预约
BERRY_MAX_ADVANCE_DAYS=60
# 未指定时长时默认预约时长（分钟）
BERRY_DEFAULT_DURATION_MINUTES=120
# 单个用户同时存在的待审核预约上限
BERRY_MAX_PENDING_PER_USER=3
# 私聊通知管理员失败时，是否回落到触发预约的群聊提醒
BERRY_NOTIFY_FALLBACK_GROUP=true
